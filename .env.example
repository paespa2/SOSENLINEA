# ==============================================================================
# SOSENLINEA CLOUD - VARIABLES DE ENTORNO PREDETERMINADAS (PLANTILLA)
# ==============================================================================
# Copia este archivo como '.env' para desarrollo local o configúralo en Vercel / Netlify / Azure.
# IMPORTANTE: Nunca agregues claves de acceso privadas o cadenas de conexión directas a GitHub.

# Entorno de ejecución: development | production | test
VITE_APP_ENV=development

# Título corporativo del aplicativo
VITE_APP_NAME="SOSENLINEA Cloud"

# URL base para API REST o microservicios (en caso de conectar con backend de Azure / Express)
VITE_API_BASE_URL="http://localhost:3000/api"

# Configuración de Servidor de Base de Datos (Referencial / Proxy seguro)
VITE_DB_NAME="sosenlinea_db"
VITE_ENABLE_ANALYTICS=false
