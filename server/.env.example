# ======================================================
# SOS Programaacces API - Variables de Entorno
# ======================================================
# Copiar este archivo a .env y rellenar con valores reales
# NUNCA commitear el archivo .env con credenciales

# ---------------- AZURE SQL ----------------
DB_SERVER=Programaacces.database.windows.net
DB_PORT=1433
DB_DATABASE=Programaacces
DB_USER=tu_usuario_azure_sql
DB_PASSWORD=tu_password_azure_sql
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000

# ---------------- JWT ----------------
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_al_menos_64_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------- SERVIDOR ----------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------- AUDIT ----------------
# Nombre de la tabla de auditoría en Azure SQL
AUDIT_TABLE=sos_audit_logs
